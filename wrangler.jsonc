{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  // Pinned explicitly so CI (no local `wrangler login` session, just an API
  // token) never has to guess which account to deploy to.
  "account_id": "c9374c170e8943196185ecf83339a2d2",
  "compatibility_date": "2026-09-17",
  "observability": {
    "enabled": true
  },
  "main": "worker/index.js",
  "assets": {
    "directory": "build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, Cloudflare serves a matching static file (e.g. "/" →
    // index.html) directly and never invokes the Worker at all — which
    // silently skipped bot detection entirely until this was added.
    "run_worker_first": true
  }
}
